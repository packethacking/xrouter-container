# Screenshots and ad-hoc files dropped into the working dir during
# investigation. We want them in chat context but not in git.
Screenshot*.png
*.png

# Local mirror staging — binaries are pushed to OARC; the GitHub repo
# only carries the manifest pointing at them.
/downloads/

# Local scratch
/tmp-*

# Fuzzer artefacts — produced locally, not checked in.
/fuzz/crashes/

# If anyone bind-mounts fuzz/ as /data, xrouter dumps its runtime
# state and docs in here. Ignore everything except the files we ship.
/fuzz/*.SYS
/fuzz/*.ACL
/fuzz/*.CFG.example
/fuzz/IGATE.CFG
/fuzz/CHAT/
/fuzz/FINGER/
/fuzz/FTP/
/fuzz/HELP/
/fuzz/INFO/
/fuzz/LOG/
/fuzz/MAN/
/fuzz/MISC/
/fuzz/PMS/
/fuzz/SMS/
/fuzz/SPOOL/
